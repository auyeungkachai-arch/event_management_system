<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SciFac Events - Edit Event</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    body {
      background-color: #f8f9fa;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .main-content {
      flex: 1;
    }
    .form-card {
      background: #ffffff;
      border: 1px solid #eaeaea;
      border-radius: 8px;
    }
    .form-label {
      font-weight: 600;
      color: #212529;
      margin-bottom: 0.375rem;
    }
    .text-danger {
      color: #dc3545 !important;
    }
  </style>
</head>
<body>

  <!-- Navigation Bar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <a class="navbar-brand d-flex align-items-center gap-2" href="/"> 
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          fill="#0d6efd"
          class="bi bi-flask-fill"
          viewBox="0 0 16 16"
        >
          <path
            d="M4.085 1H11.915C12.35 1 12.5 1.458 12.186 1.743L10.5 3.28V7.32l3.414 5.69c.473.788-.1 1.99-1.026 1.99H3.112c-.926 0-1.5-1.202-1.026-1.99L5.5 7.32V3.28L3.814 1.743C3.5 1.458 3.65 1 4.085 1z"
          />
        </svg>
        SciFac Events
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarSupportedContent"
        aria-controls="navbarSupportedContent"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-2">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" aria-current="page" href="/events">Events</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/venues">Venues</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <!-- Main Content Area -->
  <main class="main-content py-4">
    <div class="container" style="max-width: 800px;">
      
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0 text-dark fs-3">Edit Event</h2>
        <form action="/event/delete/<%= event._id %>" method="POST" class="m-0" onsubmit="return confirm('Are you sure you want to delete this event?');">
          <button type="submit" class="btn btn-danger d-flex align-items-center gap-2 px-3 py-2 fw-medium">
            <i class="bi bi-trash"></i>
            Delete
          </button>
        </form>
      </div>

      <!-- Form Container Card -->
      <div class="card form-card shadow-sm p-4 border-0">
        <!-- 修正 action 引號 -->
        <form action="/event/edit/<%= event._id %>" method="POST">

          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label">Title <span class="text-danger">*</span></label>
            <input 
              type="text" 
              class="form-control" 
              id="title" 
              name="title" 
              value="<%= event.title %>"
              maxlength="200" 
              required
            >
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea 
              class="form-control" 
              id="description" 
              name="description" 
              rows="4"
            ><%= event.description %></textarea>
          </div>

          <!-- Category & Date & Time Row -->
          <div class="row g-3 mb-3">
            <!-- Category -->
            <div class="col-md-6">
              <label for="category" class="form-label">Category <span class="text-danger">*</span></label>
              <select class="form-select" id="category" name="category" required>
                <option value="" disabled>Select Category</option>
                <% if (typeof Category !== 'undefined' && Category.length > 0) { %>
                  <% for (let i = 0; i < Category.length; i++) { %>
                    <option value="<%= Category[i] %>" <%= event.category === Category[i] ? 'selected' : '' %>>
                      <%= Category[i] %>
                    </option>
                  <% } %>
                <% } %>
              </select>
            </div>

            <!-- Date & Time -->
            <div class="col-md-6">
              <label for="dateTime" class="form-label">Date & Time <span class="text-danger">*</span></label>
              <input 
                type="datetime-local" 
                class="form-control" 
                id="dateTime" 
                name="dateTime" 
                value="<%= event.dateTime ? new Date(event.dateTime).toISOString().slice(0, 16) : '' %>"
                required
              >
            </div>
          </div>

          <!-- Speaker / Organizer & Capacity Row -->
          <div class="row g-3 mb-3">
            <!-- Speaker / Organizer -->
            <div class="col-md-6">
              <label for="speaker" class="form-label">Speaker / Organizer</label>
              <input 
                type="text" 
                class="form-control" 
                id="speaker" 
                name="speaker"
                value="<%= event.speaker || '' %>"
              >
            </div>

            <!-- Capacity -->
            <div class="col-md-6">
              <label for="capacity" class="form-label">Capacity <span class="text-danger">*</span></label>
              <input 
                type="number" 
                class="form-control" 
                id="capacity" 
                name="capacity" 
                value="<%= event.capacity %>"
                min="1" 
                required
              >
            </div>
          </div>

          <!-- Venue & Status Row -->
          <div class="row g-3 mb-3">
            <!-- Venue (已修正 venue_name 改為 event.venue) -->
            <div class="col-md-6">
              <label for="venue" class="form-label">Venue</label>
              <select class="form-select" id="venue" name="venue">
                <option value="">No Venue</option>
                <% if (typeof venues !== 'undefined' && venues.size > 0) { %>
                  <% venues.forEach(function(venueObj, venueKey) { %>
                    <option value="<%= venueKey %>" data-capacity="<%= venueObj.capacity %>" <%= event.venue && event.venue.toString() === venueKey.toString() ? 'selected' : '' %>>
                    <%= venueObj.name %> (Cap: <%= venueObj.capacity %>)
                    </option>
                <% }); %>
                <% } %>
              </select>
            </div>

            <!-- Status -->
            <div class="col-md-6">
              <label for="status" class="form-label">Status</label>
              <select class="form-select" id="status" name="status">
                <% if (typeof Status !== 'undefined' && Status.length > 0) { %>
                  <% for (let i = 0; i < Status.length; i++) { %>
                    <option value="<%= Status[i] %>" <%= event.status === Status[i] ? 'selected' : '' %>>
                      <%= Status[i] %>
                    </option>
                  <% } %>
                <% } else { %>
                  <option value="Upcoming" <%= event.status === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
                  <option value="Ongoing" <%= event.status === 'Ongoing' ? 'selected' : '' %>>Ongoing</option>
                  <option value="Completed" <%= event.status === 'Completed' ? 'selected' : '' %>>Completed</option>
                  <option value="Cancelled" <%= event.status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
                <% } %>
              </select>
            </div>
          </div>

          <!-- Banner Image URL -->
          <div class="mb-3">
            <label for="bannerImage" class="form-label">Banner Image URL</label>
            <input 
              type="url" 
              class="form-control" 
              id="bannerImage" 
              name="bannerImage" 
              value="<%= event.bannerImage || '' %>"
              placeholder="https://images.unsplash.com/photo-..."
            >
          </div>

          <!-- Highlight Checkbox -->
          <div class="form-check mb-4">
            <input 
              class="form-check-input" 
              type="checkbox" 
              id="isHighlighted" 
              name="isHighlighted" 
              value="true"
              <%= event.isHighlighted ? 'checked' : '' %>
            >
            <label class="form-check-label text-secondary" for="isHighlighted">
              Highlight on Homepage Carousel
            </label>
          </div>

          <!-- Submit & Cancel Buttons -->
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-3 fw-medium">Save Event</button>
            <a href="/event/detail/<%= event._id %>" class="btn btn-outline-secondary px-3">Cancel</a>
          </div>

        </form>
      </div>

    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-dark text-white-50 text-center py-3 fs-7">
    <div class="container">
      <small>© 2026 Science Faculty Event Management System. All rights reserved.</small>
    </div>
  </footer>

  <!-- Dynamic Capacity Validation Script -->
  <script>
    const capacityInput = document.getElementById('capacity');
    const venueSelect = document.getElementById('venue');

    capacityInput.addEventListener('input', function () {
      const reqCap = parseInt(this.value, 10) || 0;

      Array.from(venueSelect.options).forEach(option => {
        if (!option.value) return; // Skip "No Venue" option

        const venueCap = parseInt(option.getAttribute('data-capacity'), 10) || 0;

        if (venueCap < reqCap) {
          option.disabled = true;
          option.textContent = `${option.textContent.split(' (')[0]} (Cap: ${venueCap} Too Small)`;
        } else {
          option.disabled = false;
          option.textContent = `${option.textContent.split(' (')[0]} (Cap: ${venueCap})`;
        }
      });
    });
  </script>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>